{
  "name": "picfind",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:safe": "node scripts/dev.mjs --safe",
    "dev:web": "npm run dev --workspace @picfind/web",
    "dev:api": "npm run dev --workspace @picfind/api",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "setup": "node scripts/setup-library.mjs",
    "setup:billing": "node scripts/setup-billing.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "preflight": "node --import tsx scripts/check-launch-config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/supertest": "^6.0.0",
    "eslint": "^9.39.0",
    "globals": "^16.0.0",
    "jsqr": "1.4.0",
    "prettier": "^3.6.0",
    "supertest": "^7.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.0"
  }
}
