# Runtime configuration. Never put secrets in VITE_ variables.
NODE_ENV=development
PORT=3001
HOST=127.0.0.1
WEB_ORIGIN=http://127.0.0.1:5173
# Enable Google in Appwrite Console > Auth > Settings > OAuth2 providers.
# Use Appwrite's callback URL in Google Cloud, not the Drive callback below.
GOOGLE_OAUTH_ENABLED=true
# Configure these through deployment secrets management.
APPWRITE_ENDPOINT=
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
# Gallery setup: node scripts/setup-library.mjs. Runtime uses TablesDB and private storage.
# Optional public Google Drive folder import. Never expose this key to the browser.
GOOGLE_DRIVE_API_KEY=
# User Drive access is Google OAuth in PicFind (not Cursor Drive MCP).
# Google Cloud Console: enable Drive API, create a Web OAuth client,
# redirect URI {WEB_ORIGIN}/api/drive/callback
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
# Phase 4 uses test mode until production activation is verified.
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PAYMENTS_API_KEY=
DODO_WEBHOOK_SECRET=
# Billing schema and webhook verification are required before opting in.
BILLING_ENABLED=false
BILLING_CHECKOUT_ENABLED=false
BILLING_LIVE_APPROVED=false
# Separate role accounting rollout; does not enable checkout. Keep off until acceptance.
BILLING_ROLE_CATALOG_ENABLED=false
# Additional live-only approval after role catalog/provider acceptance; never needed for TEST.
BILLING_ROLE_CATALOG_LIVE_APPROVED=false
# Read-only provider recovery; requires billing schema and TEST acceptance first.
BILLING_RECONCILIATION_ENABLED=false
DODO_PRODUCT_PHOTO_PACK_INR=
DODO_PRODUCT_PHOTO_PACK_USD=
DODO_PRODUCT_CREATOR_INR=
DODO_PRODUCT_CREATOR_USD=
DODO_PRODUCT_STUDIO_INR=
DODO_PRODUCT_STUDIO_USD=
# Face matching is off until AWS credentials work. Never use VITE_ for AWS keys.
FACE_PROVIDER=none
AWS_REGION=ap-south-1
REKOGNITION_NAMESPACE=picfind-dev
REKOGNITION_MATCH_THRESHOLD=80
REKOGNITION_MAX_MATCHES=50
FACE_INDEX_MAX=20
RETENTION_WORKER_ENABLED=false
# Requires the private processing-jobs table. Safe mode still disables all face calls.
JOB_WORKER_ENABLED=true
# Use the default AWS credential chain. Never commit access keys.

# Read-only cloud sources: callbacks are WEB_ORIGIN/api/sources/{provider}/callback.
# A server-only encryption key: 32 random bytes encoded as 64 hex characters.
SOURCE_COOKIE_KEY=
# Enable after running node scripts/setup-source-connections.mjs. Keep the key stable.
SOURCE_CONNECTIONS_ENABLED=false
CLOUD_IMPORT_WORKER_ENABLED=false
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=
BOX_CLIENT_ID=
BOX_CLIENT_SECRET=

# Separate durable event ceiling. Development is always clamped to 20 photos.
# For production staging with a strict cost bound, set this to 20 explicitly.
EVENT_INDEX_MAX=10000
